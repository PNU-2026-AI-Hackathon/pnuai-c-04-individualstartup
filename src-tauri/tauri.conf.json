{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CADGEN-AX",
  "identifier": "dev.cadgen-ax.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build && npm run clean:obsolete-cli-tools && npm run build:sidecar:release",
    "frontendDist": "../dist/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CADGEN-AX",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "target/release/cadgen-ax-structural-anchor",
      "target/release/cadgen-ax-vlm-renderer"
    ]
  }
}
