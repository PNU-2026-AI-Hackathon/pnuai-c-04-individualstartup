{
  "name": "cadastrophe",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Text-to-CAD Tauri desktop workspace",
  "scripts": {
    "dev:ui": "vite --host 127.0.0.1",
    "dev:tauri": "npm run build:cli-tools && tauri dev",
    "build": "tsc --noEmit && vite build",
    "build:tauri": "tauri build",
    "build:sidecar": "node scripts/build-structural-sidecar.mjs --profile debug",
    "build:sidecar:release": "node scripts/build-structural-sidecar.mjs --profile release",
    "build:cli-tools": "cargo build --manifest-path src-tauri/Cargo.toml --bins && npm run build:sidecar",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:cli-manual": "node scripts/manual-cli-smoke.mjs",
    "smoke:tauri": "CADASTROPHE_TAURI_SMOKE=1 CADASTROPHE_AGENT_ADAPTER=fake tauri dev",
    "smoke:codex": "cargo run --manifest-path src-tauri/Cargo.toml --bin codex_smoke --"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^0.468.0",
    "openscad-wasm": "^0.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.178.1",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
